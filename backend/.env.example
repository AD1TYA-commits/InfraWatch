# Copy this file to .env and fill in values as needed.

# Database. Leave as-is for zero-setup local dev (SQLite file).
# For Docker/Postgres+PostGIS: postgresql+psycopg2://infrawatch:infrawatch@db:5432/infrawatch
DATABASE_URL=sqlite:///./infrawatch.db

# Satellite mode: "real" fetches public Sentinel-2 L2A scenes from Planetary
# Computer without an account. Use "demo" only for fully offline operation.
SATELLITE_MODE=real
SATELLITE_PROVIDER=planetary-computer

# Required only when SATELLITE_MODE=real. Register an OAuth client at
# https://dataspace.copernicus.eu to obtain these.
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# Gemini Vision AI
GEMINI_API_KEY=
AI_VISION_PROVIDER=gemini
AI_VISION_MODEL=gemini-3.5-flash-lite
