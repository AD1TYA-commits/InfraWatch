# Copy this file to .env and fill in values as needed.

# Database. Leave as-is for zero-setup local dev (SQLite file).
# For Docker/Postgres+PostGIS: postgresql+psycopg2://infrawatch:infrawatch@db:5432/infrawatch
DATABASE_URL=sqlite:///./infrawatch.db

# URL of the standalone satellite-service microservice (see ../satellite-service) —
# every coordinate-based project is analyzed by calling out to it.
SATELLITE_SERVICE_URL=http://localhost:8001

# Browser origins permitted to call the API.
CORS_ORIGINS=http://localhost:3000

# Secret used to sign JWT auth tokens. The default below is dev-only and
# intentionally insecure (checked into git) — always set a real random value
# for any deployment other than local dev, e.g.: openssl rand -hex 32
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
JWT_EXPIRE_MINUTES=10080
